# Copy to .env and fill in real values. Never commit .env.

# --- Postgres ---
POSTGRES_DB=expensa
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Owner role: created by the Postgres container, owns the schema, runs
# Alembic migrations. Superuser locally is fine — it never serves app traffic.
POSTGRES_OWNER_USER=expensa_owner
POSTGRES_OWNER_PASSWORD=changeme-owner-password

# App role: created by migration 0001, non-superuser, non-owner. FastAPI
# connects only as this role so Postgres RLS is actually enforced.
POSTGRES_APP_USER=expensa_app
POSTGRES_APP_PASSWORD=changeme-app-password

# Full connection strings (async, asyncpg driver). Alembic uses the owner
# URL; the FastAPI app uses the app URL.
DATABASE_URL_OWNER=postgresql+asyncpg://expensa_owner:changeme-owner-password@localhost:5432/expensa
DATABASE_URL_APP=postgresql+asyncpg://expensa_app:changeme-app-password@localhost:5432/expensa

# --- JWT ---
JWT_SECRET_KEY=changeme-generate-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google OAuth (Authlib) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Redis (rate limiting, jobs, refresh-token tracking) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO locally, S3-compatible) ---
S3_ENDPOINT_URL=http://localhost:9000
# Used only to sign presigned GET URLs, which a browser follows from outside
# Docker — keep this as the host-reachable address even when S3_ENDPOINT_URL
# above is overridden to the internal Docker hostname (minio:9000).
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=expensa-receipts
S3_REGION=us-east-1

# --- OpenAI (extraction) ---
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4o-mini

# --- Upload guardrails (enforced before any OpenAI call) ---
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_PDF_PAGES=1

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173

# --- Frontend (Vite, exposed to the browser — no secrets here) ---
VITE_API_BASE_URL=http://localhost:8000
